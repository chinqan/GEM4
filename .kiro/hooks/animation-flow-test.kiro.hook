{
  "enabled": true,
  "name": "Animation Flow Tests",
  "description": "Runs animation flow integration tests. Use after modifying cascade, animation, or renderer files to catch timing/ordering bugs.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "npx vitest run src/rendering/__tests__/animation-flow.test.ts --reporter=verbose"
  }
}
