{
    "kiroAgent.trustedCommands": [
        "npm *",
        "npx *",
        "touch *",
        "mkdir *",
        "grep *",
        "node *",
        "ls *",
        "head *",
        "echo *",
        "cat *",
        "test *",
        "git *",
        "wc *",
        "python *",
        "GRAPHIFY_BIN=$(which *",
        "$(cat *",
        "cp *",
        "which *",
        "/opt/anaconda3/bin/python *"
    ],
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/.git/objects/**": true,
        "**/graphify-out/**": true,
        "**/public/assets/sfx/**": true,
        "**/public/assets/gems/**": true,
        "**/test-results/**": true,
        "**/playwright-report/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/graphify-out": true,
        "**/package-lock.json": true,
        "**/public/assets/sfx": true,
        "**/public/assets/gems": true,
        "**/*.wav": true,
        "**/test-results": true,
        "**/playwright-report": true,
        "**/gdd/audits": true
    }
}