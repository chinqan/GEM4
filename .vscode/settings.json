{
    "kiroAgent.trustedCommands": [
        "npm *",
        "npx *",
        "touch *",
        "mkdir *",
        "grep *",
        "node *",
        "ls *",
        "head *",
        "echo *",
        "cat *",
        "test *",
        "git *",
        "wc *",
        "python *",
        "GRAPHIFY_BIN=$(which *",
        "$(cat *",
        "cp *",
        "which *",
        "/opt/anaconda3/bin/python *",
        "find *",
        "/Users/chinqan/opt/anaconda3/bin/python *",
        "file *",
        "rm -f graphify-out/.graphify_cached.json graphify-out/.graphify_uncached.txt graphify-out/.graphify_semantic_new.json",
        "rm -f graphify-out/.graphify_extract.json graphify-out/.graphify_ast.json graphify-out/.graphify_semantic.json graphify-out/.graphify_analysis.json graphify-out/.graphify_labels.json graphify-out/.graphify_incremental.json graphify-out/.graphify_old.json graphify-out/.graphify_detect.json\nrm -f graphify-out/.needs_update 2>/dev/null || true"
    ],
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/.git/objects/**": true,
        "**/graphify-out/**": true,
        "**/public/assets/sfx/**": true,
        "**/public/assets/gems/**": true,
        "**/test-results/**": true,
        "**/playwright-report/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/graphify-out": true,
        "**/package-lock.json": true,
        "**/public/assets/sfx": true,
        "**/public/assets/gems": true,
        "**/*.wav": true,
        "**/test-results": true,
        "**/playwright-report": true,
        "**/gdd/audits": true
    }
}